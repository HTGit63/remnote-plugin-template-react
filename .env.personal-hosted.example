# .env.personal-hosted.example
# Copy to .env for personal hosted companion server

# Deployment Mode: local_dev | personal_hosted_token | public_hosted_oauth
REMNOTE_BRIDGE_DEPLOYMENT_MODE=personal_hosted_token

# Must bind to 0.0.0.0 for public port routing
REMNOTE_BRIDGE_HOST=0.0.0.0
REMNOTE_BRIDGE_PORT=80

# Public canonical URL settings (must start with https://)
REMNOTE_BRIDGE_PUBLIC_BASE_URL=https://your-personal-bridge.onrender.com
REMNOTE_BRIDGE_MCP_RESOURCE=https://your-personal-bridge.onrender.com
REMNOTE_BRIDGE_DASHBOARD_URL=https://your-personal-bridge.onrender.com/dashboard

# Secure connection token (must be long and secure)
REMNOTE_BRIDGE_TOKEN=super-secure-high-entropy-companion-token-here

# Strict CORS settings
REMNOTE_BRIDGE_ALLOW_CORS=1
REMNOTE_BRIDGE_ALLOWED_ORIGINS=https://www.remnote.com,https://chat.openai.com

# Single port routing for Render deployment
REMNOTE_BRIDGE_SINGLE_PORT=true
REMNOTE_BRIDGE_WS_PATH=/remnote-bridge
REMNOTE_BRIDGE_MCP_PATH=/mcp

# Logging and security
REMNOTE_BRIDGE_AUDIT_LOG=true
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=true
REMNOTE_BRIDGE_TIMEOUT_MS=120000
