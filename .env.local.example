# .env.local.example
# Copy to .env for local development

# Deployment Mode: local_dev | personal_hosted_token | public_hosted_oauth
REMNOTE_BRIDGE_DEPLOYMENT_MODE=local_dev

# Secure local communication token (must match client plugin settings)
REMNOTE_BRIDGE_TOKEN=local-dev-secret-token-12345

# Allowed CORS origins
REMNOTE_BRIDGE_ALLOW_CORS=1
REMNOTE_BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,https://www.remnote.com

# Isolated local testing options
REMNOTE_BRIDGE_ALLOW_NO_TOKEN=0
REMNOTE_BRIDGE_ALLOW_REMOTE=0

# Bind host and port options
REMNOTE_BRIDGE_HOST=127.0.0.1
REMNOTE_BRIDGE_PORT=47392
REMNOTE_BRIDGE_SINGLE_PORT=true
REMNOTE_BRIDGE_WS_PORT=47391
REMNOTE_BRIDGE_WS_PATH=/remnote-bridge
REMNOTE_BRIDGE_MCP_PATH=/mcp

# Tool Profile: simple | full
REMNOTE_BRIDGE_TOOL_PROFILE=full

# Toggle audit log output to stdout
REMNOTE_BRIDGE_AUDIT_LOG=true

# Allow delete operations (guarded by delete_rem_by_id)
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=true
