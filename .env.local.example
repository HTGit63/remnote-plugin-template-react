# Loopback-only bridge template for CLI/Inspector development.
# ChatGPT cannot reach localhost. For ChatGPT testing, use .env.example with
# hosted pairing and expose port 47392 through ngrok as documented in README.
# Load this file explicitly; the server does not auto-load .env:
#   cp .env.local.example .env
#   set -a; source .env; set +a; npm run server:dev

REMNOTE_BRIDGE_DEPLOYMENT_MODE=local

# Generate a long random value and copy the same token into local test clients.
REMNOTE_BRIDGE_TOKEN=replace-with-long-random-local-token

# Local CORS is needed by the RemNote desktop plugin.
REMNOTE_BRIDGE_ALLOW_CORS=1
REMNOTE_BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,https://remnote.com,https://www.remnote.com

# Never set no-token mode when a tunnel or remote bind is active.
REMNOTE_BRIDGE_ALLOW_NO_TOKEN=0
REMNOTE_BRIDGE_ALLOW_REMOTE=0

# Local mode keeps separate WebSocket and MCP ports.
REMNOTE_BRIDGE_HOST=127.0.0.1
REMNOTE_BRIDGE_SINGLE_PORT=false
REMNOTE_BRIDGE_WS_PORT=47391
REMNOTE_BRIDGE_MCP_PORT=47392
REMNOTE_BRIDGE_WS_PATH=/remnote-bridge
REMNOTE_BRIDGE_MCP_PATH=/mcp

# Profiles: basic | mass_note_writer | note_writer | power_user | developer | danger
REMNOTE_BRIDGE_TOOL_PROFILE=developer
REMNOTE_BRIDGE_AUDIT_LOG=true

# Delete stays hidden unless explicitly needed for a disposable local test.
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=false
