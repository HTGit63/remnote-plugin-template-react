# .env.public-hosted.example
# Copy to .env for public multi-tenant hosted OAuth mode (requires DB & OAuth credentials).
# Load it before npm run server:start with: set -a; source .env; set +a

# Canonical hosted mode. Legacy public_hosted_oauth remains accepted.
REMNOTE_BRIDGE_DEPLOYMENT_MODE=hosted
REMNOTE_BRIDGE_ENABLE_HOSTED_PAIRING=1
REMNOTE_BRIDGE_SESSION_SECRET=replace-with-a-long-random-session-secret
REMNOTE_BRIDGE_ADMIN_DEBUG_SECRET=replace-with-a-different-long-random-admin-secret

# Server host and port configuration
REMNOTE_BRIDGE_HOST=0.0.0.0
PORT=10000

# Canonical URLs (must use HTTPS)
REMNOTE_BRIDGE_PUBLIC_BASE_URL=https://remnote-plugin-template-react.onrender.com
REMNOTE_BRIDGE_MCP_RESOURCE=https://remnote-plugin-template-react.onrender.com
REMNOTE_BRIDGE_DASHBOARD_URL=https://remnote-plugin-template-react.onrender.com/dashboard

# Durable database URL (PostgreSQL required)
REMNOTE_BRIDGE_STORAGE=postgres
DATABASE_URL=postgresql://db_user:db_password@postgres-host:5432/bridge_db?sslmode=require

# Google OIDC/OAuth 2.0 Credentials (for dashboard login)
REMNOTE_BRIDGE_OAUTH_PROVIDER=google
REMNOTE_BRIDGE_OAUTH_CLIENT_ID=google-client-id-here.apps.googleusercontent.com
REMNOTE_BRIDGE_OAUTH_CLIENT_SECRET=google-client-secret-here
REMNOTE_BRIDGE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
REMNOTE_BRIDGE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
REMNOTE_BRIDGE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Strict CORS settings
REMNOTE_BRIDGE_ALLOW_CORS=1
REMNOTE_BRIDGE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://remnote.com,https://www.remnote.com,https://remnote-plugin-template-react.onrender.com

# ChatGPT MCP OAuth issuer and token lifetime
REMNOTE_BRIDGE_OAUTH_ISSUER=https://remnote-plugin-template-react.onrender.com
REMNOTE_BRIDGE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
REMNOTE_BRIDGE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Rate limits
REMNOTE_BRIDGE_RATE_LIMIT_WINDOW_MS=60000
REMNOTE_BRIDGE_RATE_LIMIT_MAX_REQUESTS=120

# Single port routing
REMNOTE_BRIDGE_SINGLE_PORT=true
REMNOTE_BRIDGE_WS_PATH=/remnote
REMNOTE_BRIDGE_MCP_PATH=/mcp

# General configurations
REMNOTE_BRIDGE_AUDIT_LOG=true
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=false
REMNOTE_BRIDGE_TIMEOUT_MS=120000

# ChatGPT-hosted media limits. Successful URL-backed media retain required
# bytes because RemNote still references the public bridge URL.
REMNOTE_MCP_HOSTED_IMAGE_MAX_BYTES=10485760
REMNOTE_MCP_HOSTED_AUDIO_MAX_BYTES=26214400
REMNOTE_MCP_HOSTED_VIDEO_MAX_BYTES=52428800
REMNOTE_MCP_HOSTED_IMAGE_REMOTE_TIMEOUT_MS=30000
