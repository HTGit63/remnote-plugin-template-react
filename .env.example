# Hosted bridge template: Render in production, or local port 47392 behind ngrok.
# Copy to .env, replace every placeholder, then load it before starting:
#   set -a
#   source .env
#   set +a
#   npm run server:dev
# This project does not auto-load .env files.

# Public HTTPS origin only; no trailing path. For ngrok use https://NAME.ngrok.app.
REMNOTE_BRIDGE_PUBLIC_BASE_URL=https://your-render-service.onrender.com
# OAuth resource identifier is the public origin. ChatGPT still connects to /mcp.
REMNOTE_BRIDGE_MCP_RESOURCE=https://your-render-service.onrender.com
REMNOTE_BRIDGE_DASHBOARD_URL=https://your-render-service.onrender.com/dashboard
REMNOTE_BRIDGE_OAUTH_ISSUER=https://your-render-service.onrender.com

# Generate independent values, for example: openssl rand -hex 32
# Never commit the resulting .env file.
REMNOTE_BRIDGE_SESSION_SECRET=replace-with-strong-random-secret
REMNOTE_BRIDGE_ADMIN_DEBUG_SECRET=replace-with-different-admin-secret
PAIRING_CODE_TTL_SECONDS=600
AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Hosted pairing, jobs, idempotency, and uploaded media require PostgreSQL.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
REMNOTE_BRIDGE_STORAGE=postgres

NODE_ENV=production
REMNOTE_BRIDGE_DEPLOYMENT_MODE=hosted
REMNOTE_BRIDGE_ENABLE_HOSTED_PAIRING=1
REMNOTE_BRIDGE_ALLOW_NO_TOKEN=0

# ChatGPT files are downloaded once, validated by bytes, and stored in PostgreSQL.
# Successful assets stay because RemNote still references their public bridge URL.
# Only proven no-write orphans are deleted. Monitor aggregate database usage.
REMNOTE_MCP_HOSTED_IMAGE_MAX_BYTES=10485760
REMNOTE_MCP_HOSTED_AUDIO_MAX_BYTES=26214400
REMNOTE_MCP_HOSTED_VIDEO_MAX_BYTES=52428800
REMNOTE_MCP_HOSTED_IMAGE_REMOTE_TIMEOUT_MS=30000

# Render replaces PORT. Local/ngrok development uses 47392.
REMNOTE_BRIDGE_SINGLE_PORT=1
REMNOTE_BRIDGE_HOST=0.0.0.0
PORT=47392

# Include ChatGPT, RemNote, and the exact Render/ngrok public origin.
REMNOTE_BRIDGE_ALLOW_CORS=1
REMNOTE_BRIDGE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://remnote.com,https://www.remnote.com,https://your-render-service.onrender.com

# Plugin uses wss://PUBLIC_ORIGIN/remnote; ChatGPT uses https://PUBLIC_ORIGIN/mcp.
REMNOTE_BRIDGE_WS_PATH=/remnote
REMNOTE_BRIDGE_MCP_PATH=/mcp
PLUGIN_HEARTBEAT_INTERVAL_SECONDS=30
PLUGIN_HEARTBEAT_TIMEOUT_SECONDS=90

# Start with narrow normal profile. Developer profile is for diagnostics.
REMNOTE_BRIDGE_TOOL_PROFILE=mass_note_writer
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=0

LOG_LEVEL=info
REDACT_SECRETS_IN_LOGS=true

# Local-token mode only. Hosted ChatGPT/Codex pairing does not use this value.
REMNOTE_BRIDGE_TOKEN=
