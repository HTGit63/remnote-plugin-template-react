# Public URLs
PUBLIC_BASE_URL=https://your-render-service.onrender.com
MCP_SERVER_URL=https://your-render-service.onrender.com/mcp
OAUTH_ISSUER=https://your-render-service.onrender.com

# Security
SESSION_SECRET=replace-with-strong-random-secret
ADMIN_DEBUG_SECRET=replace-with-admin-secret
PAIRING_CODE_TTL_SECONDS=600
AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Storage
# Production public-hosted mode currently supports PostgreSQL through DATABASE_URL.
# REDIS_URL is reserved for a future RedisSessionStore.
DATABASE_URL=
REDIS_URL=

# Environment
NODE_ENV=production
ALLOW_DEV_NO_AUTH=false
REMNOTE_BRIDGE_DEPLOYMENT_MODE=public_hosted_oauth
REMNOTE_BRIDGE_STORAGE=postgres
REMNOTE_BRIDGE_SINGLE_PORT=1
REMNOTE_BRIDGE_HOST=0.0.0.0
REMNOTE_BRIDGE_PORT=47392
PORT=47392

# CORS / Origins
# Include ChatGPT, your Render origin, and the RemNote app origin used by your plugin runtime.
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://www.remnote.com,https://your-render-service.onrender.com
REMNOTE_BRIDGE_ALLOW_CORS=1

# WebSocket
PLUGIN_WS_PATH=/remnote
PLUGIN_HEARTBEAT_INTERVAL_SECONDS=30
PLUGIN_HEARTBEAT_TIMEOUT_SECONDS=90

# MCP
REMNOTE_BRIDGE_MCP_PATH=/mcp
REMNOTE_BRIDGE_TOOL_PROFILE=full
REMNOTE_BRIDGE_ENABLE_DELETE_TOOL=0

# Logging
LOG_LEVEL=info
REDACT_SECRETS_IN_LOGS=true

# Local/personal mode only. Never enable in production public-hosted mode.
REMNOTE_BRIDGE_TOKEN=
REMNOTE_BRIDGE_ALLOW_NO_TOKEN=0
